<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 문화권 기능을 안 쓴다 — 주고받는 것이 JSON 한 줄뿐이다. 트리밍도 그만큼 더 잘 된다. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 설치본은 자체 포함으로 낸다(설치한 PC 에 .NET 이 없어도 돌아야 한다).
         앱 쪽이 RID 를 물려주므로 여기에도 같은 RID 가 선언돼 있어야 복원이 된다. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- **런타임을 통째로 안고 가지 않는다.** 그냥 자체 포함으로 내면 이 작은 도우미 하나에
         75MB 가 붙는다(그때 설치본 전체가 213MB 였다). 하는 일이 파이프로 JSON 한 줄을
         주고받는 것뿐이라 잘라낼 수 있다 — 그래서 요청 JSON 도 직렬화기(리플렉션) 대신
         Utf8JsonWriter 로 직접 쓴다. <see cref="Program.BuildRequest"/> 참조.

         AOT 가 더 작지만 이 PC 에서는 VS 링커를 못 불러 실패했다. 빌드 환경을 타는 쪽보다
         어디서나 되는 쪽을 고른다 — 트리밍만으로도 충분히 줄어든다. -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <TrimMode>full</TrimMode>

    <!-- 에이전트가 이름으로 부른다. 어셈블리 이름이 곧 명령 이름이다. -->
    <AssemblyName>agentclihub-browser</AssemblyName>
    <RootNamespace>LlmTools.Cli</RootNamespace>
    <Product>Agent CLI Hub browser bridge</Product>
    <Version>1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\LlmTools\UpgradeMigration.cs" Link="UpgradeMigration.cs" />
  </ItemGroup>
</Project>
