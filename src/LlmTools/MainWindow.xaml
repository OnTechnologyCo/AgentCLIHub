<Window x:Class="LlmTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LLM Tools"
        Icon="app.ico"
        Height="820" Width="1100"
        MinHeight="360" MinWidth="520"
        Background="#1A1A1A"
        WindowStartupLocation="CenterScreen">

    <!-- 창 전체가 WebView2 하나다. 화면(터미널·입력줄·설정)은 전부 web/index.html 이 그린다 —
         xterm.js 가 브라우저 것이라 터미널이 거기 있어야 하고, 그러면 나머지도 같은 자리에
         두는 편이 낫다(WPF 와 HTML 로 화면을 반씩 나누면 스타일이 두 벌이 된다). -->
    <Grid>
        <wv2:WebView2 x:Name="View" />

        <!-- 브라우저 탭들이 앉는 자리. **화면이 사각형을 재서 알려 준다**(browser.layout) —
             머리줄 높이는 탭 수에 따라 달라지므로 여기서 짐작할 수가 없다.

             WebView2 는 HwndHost 라 WPF 위에 무조건 그려진다. 그래서 이 판은 판 영역만
             정확히 덮어야 한다 — 창 전체를 덮으면 머리줄·입력줄이 가려지고, 화면 안의
             덮개(지난 대화 목록)가 뜰 때는 화면이 먼저 숨기라고 말해 준다. -->
        <Canvas x:Name="Browsers" />
    </Grid>
</Window>
