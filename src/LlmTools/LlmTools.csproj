<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- 파일·폴더 고르기만 WinForms 것을 쓴다. WPF 쪽은 최신 IFileDialog(COM) 를 타는데
         회사 PC 의 보안 제품이 그 경로를 막으면 "눌러도 창이 안 뜬다" 가 된다.
         자세한 것과 AutoUpgradeEnabled 를 끄는 이유는 Dialogs.cs 참조. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 한국어 UI 라 문화권을 안 끄고 둔다. InvariantGlobalization 을 켜면
         한국어 정렬·대소문자 비교가 불변 문화로 떨어져 파일명 비교가 미묘하게 달라진다. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>ko-KR</NeutralLanguage>

    <AssemblyName>LlmTools</AssemblyName>
    <RootNamespace>LlmTools</RootNamespace>
    <Product>LLM Tools</Product>
    <Version>1.7.0</Version>

    <!-- 탐색기·작업 표시줄에 붙는 실행 파일 아이콘. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WinForms 를 켜면 그 네임스페이스가 전역 using 으로 딸려 들어와 Application ·
       MessageBox 가 WPF 것과 이름이 겹친다. **전역에서는 빼 둔다** — WinForms 를 쓰는 곳은
       Dialogs.cs 하나뿐이고 거기서는 별칭(WinForms.)으로 부른다. 이렇게 두면 다른 파일이
       실수로 WinForms 쪽 MessageBox 를 집어 드는 일도 없다. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- 세션 쿠키를 이 Windows 계정에 묶어 암호화한다(CookieVault). 쿠키 값이 곧
         로그인 토큰이라 평문으로 두면 파일 하나 복사로 계정이 넘어간다. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- **같은 파일을 두 번 건다.** ApplicationIcon 은 실행 파일에 박히는 것이라
       실행 중인 창은 그것을 못 읽는다 — 제목 표시줄과 Alt+Tab 은 Window.Icon 을 보고,
       그쪽은 리소스로 들어가 있어야 한다. 하나만 걸면 둘 중 한 곳이 기본 아이콘으로 뜬다. -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- 웹 자산을 출력 폴더 web/ 로 그대로 옮긴다.
       SetVirtualHostNameToFolderMapping 이 이 폴더를 가상 호스트로 걸기 때문에
       빌드 산출물 안에 없으면 창이 빈 화면으로 뜬다(오류도 안 난다 — 404 만 난다). -->
  <ItemGroup>
    <Content Include="..\..\web\**\*.*"
             Link="web\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 에이전트용 도우미(llmtools-browser)를 같이 짓고 출력 폴더 agent\ 로 옮긴다.
       **경로가 정해져 있어야 한다** — 쪽지에 절대 경로로 적어 주기 때문이다
       (BrowserBridge.HelperPath). PATH 는 건드리지 않는다. -->
  <Target Name="BuildAgentHelper" AfterTargets="Build">
    <MSBuild Projects="..\LlmTools.Cli\LlmTools.Cli.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <AgentHelperFiles Include="..\LlmTools.Cli\bin\$(Configuration)\net9.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentHelperFiles)"
          DestinationFiles="@(AgentHelperFiles->'$(OutDir)agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 배포본에도 도우미를 넣는다. 위 Build 타깃은 **빌드 출력**으로만 옮기므로
       publish 폴더에는 안 들어간다 — 그러면 설치본에서 에이전트 명령이 통째로 없다.
       런타임/자체포함 설정을 그대로 물려줘야 설치한 PC 에 .NET 이 없어도 돈다. -->
  <Target Name="PublishAgentHelper" AfterTargets="Publish">
    <MSBuild Projects="..\LlmTools.Cli\LlmTools.Cli.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)agent\" />
  </Target>

  <!-- 공개 소스와 배포본에 원문 라이선스·고지를 함께 제공한다. -->
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*.*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
